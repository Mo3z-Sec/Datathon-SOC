# Hospital SOC Alert System - configuration template.
# `scripts/setup.sh` copies this to .env and fills in strong random tokens for you.
# Never commit .env; never share these tokens.

# REQUIRED: analyst token (can change status, add notes, generate data). Minimum 16 characters.
SOC_ANALYST_TOKEN=CHANGE_ME_run_scripts_setup_sh
# OPTIONAL: viewer token (read-only dashboard). Leave empty to disable the viewer role.
SOC_VIEWER_TOKEN=

# Network. Keep 127.0.0.1 and reach the dashboard through an SSH tunnel (recommended).
SOC_HOST=127.0.0.1
SOC_PORT=8000

# Storage (SQLite file, relative to the project folder) and the asset inventory.
SOC_DB_PATH=data/soc.db
SOC_ASSETS_PATH=data/assets.csv

# Hospital local time offset from UTC in hours (e.g. 8 for UTC+8). Used for "after-hours" rules.
SOC_UTC_OFFSET_HOURS=0

# OPTIONAL AI explanations. none = fully offline (default). anthropic = ask the Claude API to rewrite
# explanations (only alert summaries are sent, never raw logs). Falls back to offline on any failure.
SOC_AI_PROVIDER=none
SOC_AI_API_KEY=
SOC_AI_MODEL=claude-sonnet-5-5
SOC_AI_TIMEOUT=20
